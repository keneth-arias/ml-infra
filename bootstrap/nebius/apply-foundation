#!/usr/bin/env python3
"""Inspect a saved Terraform plan and apply only worker-free foundation creates."""

import argparse
import json
import shutil
import subprocess
from pathlib import Path
from tempfile import TemporaryDirectory


FOUNDATION = {
    "nebius_mk8s_v1_cluster.training[0]",
    "nebius_billing_v1_pricing_policy.training[0]",
    "nebius_storage_v1_bucket.artifacts[0]",
}


def check_plan(plan):
    if (
        plan.get("format_version", "").split(".")[0] != "1"
        or plan.get("complete") is not True
        or plan.get("errored") is not False
        or plan.get("deferred_changes")
        or plan.get("action_invocations")
    ):
        raise ValueError("Expected a complete, successful Terraform plan.")
    for resource in plan["resource_changes"]:
        address = resource["address"]
        actions = resource["change"]["actions"]
        if (
            resource["mode"] == "data"
            and address in {"data.nebius_mk8s_v1_cluster.connected[0]", "data.nebius_billing_v1_pricing_policy.existing[0]"}
            and actions in (["read"], ["no-op"])
        ):
            continue
        if address not in FOUNDATION or actions not in (["create"], ["no-op"]):
            raise ValueError(f"Outside the worker-free foundation: {address} {actions}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("plan", type=Path)
    parser.add_argument("--apply", action="store_true", help="Apply the inspected copy.")
    args = parser.parse_args()
    with TemporaryDirectory() as tmp:
        saved = Path(tmp) / "foundation.tfplan"
        shutil.copyfile(args.plan, saved)
        raw = subprocess.check_output(["terraform", "show", "-json", saved])
        try:
            check_plan(json.loads(raw))
        except (KeyError, ValueError) as exc:
            parser.exit(1, f"Refusing plan: {exc}\n")
        print("Verified worker-free foundation plan.", flush=True)
        if args.apply:
            result = subprocess.run(["terraform", "apply", "-input=false", "-no-color", saved])
            raise SystemExit(result.returncode)


if __name__ == "__main__":
    main()
