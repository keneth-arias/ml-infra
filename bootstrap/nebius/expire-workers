#!/usr/bin/env python3
"""At cutoff, release only the named run's expired CPU/GPU groups."""

import argparse
import json
from datetime import datetime, timezone
from pathlib import Path
from tempfile import TemporaryDirectory


from worker_cleanup import plan_release, terraform, verify_inventory


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--cluster-id", required=True)
    parser.add_argument("--run-id", required=True)
    parser.add_argument(
        "--cutoff", required=True, help="The worker_run cutoff in UTC (Z)."
    )
    parser.add_argument(
        "--apply", action="store_true", help="Apply the checked release plan."
    )
    parser.add_argument(
        "--release-now",
        action="store_true",
        help="Check an early release after removing the owned pool from desired configuration.",
    )
    parser.add_argument(
        "--inventory", type=Path, help="Protected pre-run baseline of shared resources"
    )
    parser.add_argument("--project-id")
    parser.add_argument("--profile", default="ml-prod")
    args = parser.parse_args()
    if args.inventory and not args.project_id:
        parser.error("Inventory verification requires the project ID")
    if not args.cutoff.endswith("Z"):
        parser.error("Expected a UTC timestamp ending in Z.")
    try:
        cutoff = datetime.fromisoformat(args.cutoff.replace("Z", "+00:00"))
    except ValueError:
        parser.error("Invalid cutoff timestamp.")
    if not args.release_now and datetime.now(timezone.utc) < cutoff:
        return

    with TemporaryDirectory() as directory:
        saved = Path(directory) / "release.tfplan"
        releases, orphans = plan_release(
            saved,
            profile=args.profile,
            cluster_id=args.cluster_id,
            run_id=args.run_id,
            cutoff_label=cutoff.strftime("%Y%m%d%H%M%S"),
            allow_orphans=True,
        )
        print(
            f"Verified {len(releases)} expired worker group(s) for {args.run_id}.",
            flush=True,
        )
        if releases and args.apply:
            terraform(
                "apply", "-input=false", "-lock-timeout=60s", "-no-color", str(saved)
            )
    if orphans:
        print(
            "Run-owned groups absent from Terraform state:",
            ", ".join(sorted(orphans)),
            flush=True,
        )
    if args.inventory and (args.apply or not releases):
        verify_inventory(
            args.profile,
            args.project_id,
            args.cluster_id,
            json.loads(args.inventory.read_text()),
        )
    if orphans:
        raise SystemExit(
            "Keep cleanup armed and reconcile the listed live groups through the provider."
        )


if __name__ == "__main__":
    main()
