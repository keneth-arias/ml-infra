{
  "uid": "nebius-worker-cleanup-failed",
  "title": "Nebius worker cleanup failed",
  "folderUID": "nebius-worker-cleanup",
  "ruleGroup": "Worker expiry",
  "condition": "B",
  "for": "0s",
  "noDataState": "OK",
  "execErrState": "Error",
  "labels": {"service": "nebius-worker-cleanup"},
  "annotations": {"summary": "Worker cleanup failed on {{ $labels.host_name }} for run {{ $labels.run_id }}. Check the cleanup journal and reconcile the Nebius inventory."},
  "data": [
    {
      "refId": "A",
      "relativeTimeRange": {"from": 600, "to": 0},
      "datasourceUid": "victoria-logs",
      "model": {
        "refId": "A",
        "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victoria-logs"},
        "expr": "_time:10m {service.name=\"nebius-worker-cleanup\"} event_name:=\"worker-cleanup-failed\" | rename host.name as host_name | stats by (host_name, run_id) count()",
        "queryType": "stats",
        "intervalMs": 1000,
        "maxDataPoints": 43200
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "relativeTimeRange": {"from": 0, "to": 0},
      "model": {
        "type": "threshold",
        "refId": "B",
        "expression": "A",
        "datasource": {"type": "__expr__", "uid": "__expr__"},
        "conditions": [{"type": "query", "evaluator": {"type": "gt", "params": [0]}}],
        "intervalMs": 1000,
        "maxDataPoints": 43200
      }
    }
  ]
}
