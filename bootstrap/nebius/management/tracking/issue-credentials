#!/usr/bin/env bash
# Generate the service's private PKI and initial passwords on the management host.
set -euo pipefail
umask 077
if [[ $# != 1 ]]; then
  echo "Usage: issue-credentials PRIVATE_PARENT_DIRECTORY" >&2
  exit 2
fi
parent=$(realpath -e -- "$1")
if [[ ! -d "$parent" || ! -O "$parent" || $(stat -c %a "$parent") != 700 ]]; then
  echo "Supply an existing owner-only directory (mode 0700)." >&2
  exit 2
fi
dir=$(mktemp -d "$parent/tracking-XXXXXXXX")
cd "$dir"
trap 'rm -rf -- "$dir"' ERR
openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -x509 -sha256 -days 120 \
  -subj '/CN=AirAware experiment tracking CA' -addext 'basicConstraints=critical,CA:TRUE,pathlen:0' \
  -addext 'keyUsage=critical,keyCertSign,cRLSign' -keyout ca.key -out ca.crt
for service in mlflow postgres; do
  host="$service.tracking.svc.cluster.local"
  openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -subj "/CN=$host" \
    -keyout "$service.key" -out "$service.csr"
  openssl x509 -req -sha256 -days 60 -CA ca.crt -CAkey ca.key -CAcreateserial \
    -in "$service.csr" -out "$service.crt" -extfile <(cat <<EXT
basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature
extendedKeyUsage=serverAuth
subjectAltName=DNS:$host
EXT
)
  openssl verify -purpose sslserver -verify_hostname "$host" -CAfile ca.crt "$service.crt" >&2
  rm "$service.csr"
done
openssl rand -base64 32 | tr -d '=\n' | tr '+/' '-_' > bearer
for name in password admin-password; do
  openssl rand -hex 32 | tr -d '\n' > "$name"
done
printf '%s\n' "$dir"
