#!/usr/bin/env python3
"""Run a Nebius command with credentials scoped to its process."""
import os
import sys
from pathlib import Path

if len(sys.argv) < 2:
    sys.exit("Usage: with-credentials COMMAND [ARG ...]")
env = os.environ.copy()
env.setdefault("NEBIUS_PRIVATE_KEY_FILE", str(Path.home() / ".config/ml-infra/nebius-private.pem"))
env_path = Path(env.get("ML_INFRA_ENV_FILE", Path(__file__).resolve().parents[3] / ".env"))
if env_path.exists():
    if env_path.stat().st_mode & 0o077:
        sys.exit("Restrict the credential file to its owner before use.")
    fields = {"KEY_ID": "AWS_ACCESS_KEY_ID", "SECRET_KEY": "AWS_SECRET_ACCESS_KEY"}
    for line in env_path.read_text().splitlines():
        name, sep, value = line.strip().removeprefix("export ").partition("=")
        if sep and name.strip() in fields:
            value = value.strip()
            if len(value) >= 2 and value[0] in ("'", '"') and value[0] == value[-1]:
                value = value[1:-1]
            env.setdefault(fields[name.strip()], value)
os.execvpe(sys.argv[1], sys.argv[1:], env)
