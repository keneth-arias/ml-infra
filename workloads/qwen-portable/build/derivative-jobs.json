{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "qwen-portable-mlx",
        "namespace": "airaware-web-refresh"
      },
      "spec": {
        "backoffLimit": 0,
        "template": {
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "command": [
                  "/opt/conda/bin/python",
                  "-u",
                  "/export/source/package_exports.py",
                  "mlx",
                  "/export/exports"
                ],
                "env": [
                  {
                    "name": "HOME",
                    "value": "/tmp"
                  },
                  {
                    "name": "HF_HUB_OFFLINE",
                    "value": "1"
                  },
                  {
                    "name": "PYTHONDONTWRITEBYTECODE",
                    "value": "1"
                  },
                  {
                    "name": "PYTHONPATH",
                    "value": "/export/source:/export/deps"
                  }
                ],
                "image": "docker.io/ml-infra/airaware-joint@sha256:14eb3ed9b9ca00c75acbc56991d0f1882dc8efc5306ccf5fa90366673f40b3be",
                "imagePullPolicy": "Never",
                "name": "build",
                "resources": {
                  "requests": {
                    "cpu": "4",
                    "memory": "7Gi"
                  },
                  "limits": {
                    "cpu": "6",
                    "memory": "12Gi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "volumeMounts": [
                  {
                    "mountPath": "/export",
                    "name": "export"
                  },
                  {
                    "mountPath": "/tmp",
                    "name": "tmp"
                  }
                ]
              }
            ],
            "nodeSelector": {
              "kubernetes.io/hostname": "bm"
            },
            "restartPolicy": "Never",
            "securityContext": {
              "runAsGroup": 1000,
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "volumes": [
              {
                "name": "export",
                "persistentVolumeClaim": {
                  "claimName": "qwen-portable-build"
                }
              },
              {
                "emptyDir": {},
                "name": "tmp"
              }
            ]
          }
        },
        "ttlSecondsAfterFinished": 86400
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "qwen-portable-openvino",
        "namespace": "airaware-web-refresh"
      },
      "spec": {
        "backoffLimit": 0,
        "template": {
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "command": [
                  "/bin/sh",
                  "-euxc",
                  "/opt/conda/bin/python -u /export/source/openvino_forecast.py build /export/exports/safetensors-fp32 /export/exports/openvino-fp32 /export/exports/openvino-fp16\n/opt/conda/bin/python -u /export/source/package_exports.py openvino /export/exports"
                ],
                "env": [
                  {
                    "name": "HOME",
                    "value": "/tmp"
                  },
                  {
                    "name": "HF_HUB_OFFLINE",
                    "value": "1"
                  },
                  {
                    "name": "PYTHONDONTWRITEBYTECODE",
                    "value": "1"
                  },
                  {
                    "name": "PYTHONPATH",
                    "value": "/export/source:/export/deps"
                  }
                ],
                "image": "docker.io/ml-infra/airaware-joint@sha256:14eb3ed9b9ca00c75acbc56991d0f1882dc8efc5306ccf5fa90366673f40b3be",
                "imagePullPolicy": "Never",
                "name": "build",
                "resources": {
                  "requests": {
                    "cpu": "4",
                    "memory": "17Gi"
                  },
                  "limits": {
                    "cpu": "6",
                    "memory": "26Gi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "volumeMounts": [
                  {
                    "mountPath": "/export",
                    "name": "export"
                  },
                  {
                    "mountPath": "/tmp",
                    "name": "tmp"
                  }
                ]
              }
            ],
            "nodeSelector": {
              "kubernetes.io/hostname": "bm"
            },
            "restartPolicy": "Never",
            "securityContext": {
              "runAsGroup": 1000,
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "volumes": [
              {
                "name": "export",
                "persistentVolumeClaim": {
                  "claimName": "qwen-portable-build"
                }
              },
              {
                "emptyDir": {},
                "name": "tmp"
              }
            ]
          }
        },
        "ttlSecondsAfterFinished": 86400
      }
    }
  ]
}
